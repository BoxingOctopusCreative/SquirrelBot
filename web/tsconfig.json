{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
